#!/usr/bin/env bash
# kpod — Kubernetes Pod Manager
#
# Lightweight interactive CLI for day-to-day backend / Rails work on any
# Kubernetes cluster. Requires kubectl. No other dependencies.
#
# Usage:
#   kpod                         Interactive menus
#   kpod <namespace>             Interactive menus in that namespace
#   kpod <namespace> console     Rails console (pick pod if several)
#   kpod <namespace> logs        Follow logs (pick pod if several)
#   kpod <namespace> shell       Exec bash/sh/ash (pick pod if several)
#   kpod <namespace> download    Copy file from pod
#   kpod <namespace> upload      Copy file to pod
#   kpod <namespace> console api Optional pod-name search
#   kpod -h|--help               Show help
#   kpod --version               Show version
#   kpod --update                Reinstall from the kpod source folder
#
# Environments live in ~/.config/kpod/contexts (alias|context|namespace).
# Switch Context lists kubectl get-contexts and can map missing ones.
#
# Config:
#   ~/.config/kpod/config      KEY=value settings (reserved)
#   ~/.config/kpod/favorites   Stub for future favorite pods / namespaces
#
# Compatible with bash 3.2+ (macOS / Linux). Invoke from bash or zsh.

set -euo pipefail

KPOD_NAME="kpod"
KPOD_VERSION="1.2.0"
KPOD_GIST_USER="${KPOD_GIST_USER:-MohamedBasaleh}"
KPOD_GIST_ID="${KPOD_GIST_ID:-1a1ed56eda40abd9e6bc7a018330deec}"
KPOD_TITLE="Kubernetes Pod Manager (kpod)"
KPOD_INSTALL_SOURCE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/kpod/install_source"
KPOD_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/kpod"
KPOD_CONFIG_FILE="${KPOD_CONFIG_DIR}/config"
KPOD_FAVORITES_FILE="${KPOD_CONFIG_DIR}/favorites"
KPOD_LAST_NS_FILE="${KPOD_CONFIG_DIR}/last_namespace"
KPOD_CONTEXTS_FILE="${KPOD_CONFIG_DIR}/contexts"
KPOD_ROLLOUT_TIMEOUT="${KPOD_ROLLOUT_TIMEOUT:-300s}"

CURRENT_CONTEXT=""
CURRENT_NAMESPACE=""
SELECTED_POD=""
SELECTED_CONTAINER=""

# Packed 1-based env maps: alias | kube context | namespace
ENV_ALIAS=()
ENV_CONTEXT=()
ENV_NS=()

# Indexed from 1. Parallel arrays for the last rendered pod table.
POD_NAMES=()
POD_READY=()
POD_STATUS=()
POD_RESTARTS=()
POD_AGE=()
POD_NODE=()

C_RESET=""
C_BOLD=""
C_DIM=""
C_RED=""
C_GREEN=""
C_YELLOW=""
C_BLUE=""
C_CYAN=""
C_GRAY=""
C_WHITE=""

ICON_OK="+"
ICON_ERR="x"
ICON_WARN="!"
ICON_ARROW=">"
ICON_POD="*"
ICON_NS="#"
ICON_CTX="@"

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------

init_colors() {
  if [[ ! -t 1 || -n "${NO_COLOR:-}" ]]; then
    return 0
  fi

  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
  C_CYAN=$'\033[36m'
  C_GRAY=$'\033[90m'
  C_WHITE=$'\033[37m'
}

init_icons() {
  local loc
  loc="$(printf '%s' "${LC_ALL:-}${LC_CTYPE:-}${LANG:-}")"
  case "$loc" in
    *[Uu][Tt][Ff][-_]*8*|*[Uu][Tt][Ff]8*)
      ICON_OK="✓"
      ICON_ERR="✗"
      ICON_WARN="!"
      ICON_ARROW="➜"
      ICON_POD="●"
      ICON_NS="☰"
      ICON_CTX="◎"
      ;;
  esac
}

init_config() {
  mkdir -p "$KPOD_CONFIG_DIR"

  if [[ ! -f "$KPOD_CONFIG_FILE" ]]; then
    cat > "$KPOD_CONFIG_FILE" <<'EOF'
# kpod configuration
# KEY=value
#
# Reserved for future settings, for example:
# KPOD_DEFAULT_NAMESPACE=
# KPOD_ROLLOUT_TIMEOUT=300s
EOF
  fi

  if [[ ! -f "$KPOD_FAVORITES_FILE" ]]; then
    cat > "$KPOD_FAVORITES_FILE" <<'EOF'
# kpod favorites (reserved)
# One entry per line. Planned format:
#   namespace/<name>
#   pod/<namespace>/<name>
#   context/<name>
EOF
  fi

  # shellcheck disable=SC1090
  if [[ -f "$KPOD_CONFIG_FILE" ]]; then
    set +u
    # shellcheck source=/dev/null
    . "$KPOD_CONFIG_FILE"
    set -u
  fi

  ensure_contexts_file
  load_env_maps
}

require_kubectl() {
  if ! command -v kubectl >/dev/null 2>&1; then
    print_error "kubectl not found in PATH"
    exit 1
  fi
}

load_last_namespace() {
  if [[ -f "$KPOD_LAST_NS_FILE" ]]; then
    tr -d '[:space:]' < "$KPOD_LAST_NS_FILE"
  fi
}

save_last_namespace() {
  if [[ -n "${CURRENT_NAMESPACE:-}" && "$CURRENT_NAMESPACE" != "default" ]]; then
    printf '%s\n' "$CURRENT_NAMESPACE" > "$KPOD_LAST_NS_FILE"
  fi
}

ensure_contexts_file() {
  if [[ -f "$KPOD_CONTEXTS_FILE" ]]; then
    return 0
  fi
  cat > "$KPOD_CONTEXTS_FILE" <<'EOF'
# kpod environment maps
# alias|kube-context|namespace
#
# kubectl contexts not listed here show as [not mapped]
# in Switch Context. Use "a" there to add them.
dev|Nawaqis-Dev|dev-core
staging|Nawaqis-Dev|staging-core
EOF
}

clear_env_maps() {
  ENV_ALIAS=()
  ENV_CONTEXT=()
  ENV_NS=()
}

load_env_maps() {
  clear_env_maps
  if [[ ! -f "$KPOD_CONTEXTS_FILE" ]]; then
    return 0
  fi
  local line alias ctx ns rest i=1
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    alias="${line%%|*}"
    rest="${line#*|}"
    ctx="${rest%%|*}"
    ns="${rest#*|}"
    alias="$(tolower "$(printf '%s' "$alias" | tr -d '[:space:]')")"
    ns="$(printf '%s' "$ns" | tr -d '[:space:]')"
    if [[ -z "$alias" || -z "$ctx" || -z "$ns" ]]; then
      continue
    fi
    ENV_ALIAS[i]="$alias"
    ENV_CONTEXT[i]="$ctx"
    ENV_NS[i]="$ns"
    i=$((i + 1))
  done < "$KPOD_CONTEXTS_FILE"
}

save_env_maps() {
  local i=1
  {
    cat <<'EOF'
# kpod environment maps
# alias|kube-context|namespace
EOF
    while [[ -n "${ENV_ALIAS[i]:-}" ]]; do
      printf '%s|%s|%s\n' "${ENV_ALIAS[i]}" "${ENV_CONTEXT[i]}" "${ENV_NS[i]}"
      i=$((i + 1))
    done
  } > "$KPOD_CONTEXTS_FILE"
}

env_index_by_alias() {
  local want="$1"
  local i=1
  want="$(tolower "$want")"
  while [[ -n "${ENV_ALIAS[i]:-}" ]]; do
    if [[ "${ENV_ALIAS[i]}" == "$want" ]]; then
      printf '%s' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

env_index_by_context() {
  local want="$1"
  local i=1
  while [[ -n "${ENV_ALIAS[i]:-}" ]]; do
    if [[ "${ENV_CONTEXT[i]}" == "$want" ]]; then
      printf '%s' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

env_index_by_ns() {
  local want="$1"
  local i=1
  want="$(tolower "$want")"
  while [[ -n "${ENV_ALIAS[i]:-}" ]]; do
    if [[ "$(tolower "${ENV_NS[i]}")" == "$want" ]]; then
      printf '%s' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

upsert_env_map() {
  local alias="$1"
  local ctx="$2"
  local ns="$3"
  local idx
  alias="$(tolower "$(printf '%s' "$alias" | tr -d '[:space:]')")"
  ns="$(printf '%s' "$ns" | tr -d '[:space:]')"
  if [[ -z "$alias" || -z "$ctx" || -z "$ns" ]]; then
    return 1
  fi
  idx="$(env_index_by_alias "$alias" || true)"
  if [[ -n "$idx" ]]; then
    ENV_CONTEXT[idx]="$ctx"
    ENV_NS[idx]="$ns"
  else
    idx=1
    while [[ -n "${ENV_ALIAS[idx]:-}" ]]; do
      idx=$((idx + 1))
    done
    ENV_ALIAS[idx]="$alias"
    ENV_CONTEXT[idx]="$ctx"
    ENV_NS[idx]="$ns"
  fi
  save_env_maps
}

remove_env_map_at() {
  local del="$1"
  local i="$del"
  local next
  if [[ -z "${ENV_ALIAS[del]:-}" ]]; then
    return 1
  fi
  next=$((del + 1))
  while [[ -n "${ENV_ALIAS[next]:-}" ]]; do
    ENV_ALIAS[i]="${ENV_ALIAS[next]}"
    ENV_CONTEXT[i]="${ENV_CONTEXT[next]}"
    ENV_NS[i]="${ENV_NS[next]}"
    i=$((i + 1))
    next=$((next + 1))
  done
  unset ENV_ALIAS[i]
  unset ENV_CONTEXT[i]
  unset ENV_NS[i]
  save_env_maps
}

refresh_cluster_state() {
  local ctx ns last
  ctx="$(kubectl config current-context 2>/dev/null || true)"
  if [[ -z "$ctx" ]]; then
    CURRENT_CONTEXT="(none)"
    if [[ -z "${CURRENT_NAMESPACE:-}" ]]; then
      last="$(load_last_namespace)"
      CURRENT_NAMESPACE="$(resolve_namespace "${last:-}")"
    fi
    return 1
  fi
  CURRENT_CONTEXT="$ctx"

  ns="$(kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null || true)"
  if [[ -z "${CURRENT_NAMESPACE:-}" || "$CURRENT_NAMESPACE" == "default" ]]; then
    if [[ -n "$ns" && "$ns" != "default" ]]; then
      CURRENT_NAMESPACE="$ns"
    else
      last="$(load_last_namespace)"
      if [[ -n "$last" ]]; then
        CURRENT_NAMESPACE="$(resolve_namespace "$last")"
      else
        CURRENT_NAMESPACE=""
      fi
    fi
  fi
  return 0
}

namespace_valid_for_context() {
  local ctx="$1"
  local ns="$2"
  local i=1
  if [[ -z "$ctx" || -z "$ns" || "$ns" == "default" ]]; then
    return 1
  fi
  while [[ -n "${ENV_ALIAS[i]:-}" ]]; do
    if [[ "${ENV_CONTEXT[i]}" == "$ctx" && "${ENV_NS[i]}" == "$ns" ]]; then
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

clear_screen() {
  if command -v clear >/dev/null 2>&1 && [[ -t 1 ]]; then
    clear
  else
    printf '\033[2J\033[H'
  fi
}

print_header() {
  local subtitle="${1:-}"
  clear_screen
  printf '%s==========================================%s\n' "$C_CYAN" "$C_RESET"
  printf '%s %s%s\n' "$C_BOLD" "$KPOD_TITLE" "$C_RESET"
  printf '%s==========================================%s\n' "$C_CYAN" "$C_RESET"
  printf '%s Current Context: %s%s%s\n' "$ICON_CTX" "$C_BOLD" "$(context_menu_label "${CURRENT_CONTEXT:-unknown}")" "$C_RESET"
  printf '%s Current Namespace: %s%s%s\n' "$ICON_NS" "$C_BOLD" "${CURRENT_NAMESPACE:-unknown}" "$C_RESET"
  if [[ -n "$subtitle" ]]; then
    printf '\n%s%s%s\n' "$C_DIM" "$subtitle" "$C_RESET"
  fi
  printf '\n'
}

print_error() {
  printf '%s%s %s%s\n' "$C_RED" "$ICON_ERR" "$1" "$C_RESET" >&2
}

print_success() {
  printf '%s%s %s%s\n' "$C_GREEN" "$ICON_OK" "$1" "$C_RESET"
}

print_info() {
  printf '%s%s %s%s\n' "$C_CYAN" "$ICON_ARROW" "$1" "$C_RESET"
}

print_warn() {
  printf '%s%s %s%s\n' "$C_YELLOW" "$ICON_WARN" "$1" "$C_RESET"
}

restore_tty() {
  if [[ ! -r /dev/tty || ! -w /dev/tty ]]; then
    return 0
  fi
  stty sane < /dev/tty 2>/dev/null || true
  stty icrnl icanon echo -echoctl < /dev/tty 2>/dev/null || true
}

read_line() {
  local dest=""
  restore_tty
  if [[ -r /dev/tty ]]; then
    IFS= read -r dest < /dev/tty || dest=""
  else
    IFS= read -r dest || dest=""
  fi
  dest="$(printf '%s' "$dest" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  printf '%s' "$dest"
}

pause() {
  if [[ "${SKIP_PAUSE:-0}" == "1" ]]; then
    return 0
  fi
  printf '\n%sPress ENTER to continue...%s' "$C_DIM" "$C_RESET"
  read_line >/dev/null || true
}

read_prompt() {
  local prompt="$1"
  printf '%s' "$prompt" >&2
  read_line
}

read_choice() {
  local prompt="${1:-Select: }"
  read_prompt "$prompt"
}

confirm() {
  local prompt="${1:-Continue?}"
  local answer
  printf '%s\n\n(y/N) ' "$prompt" >&2
  answer="$(read_line)"
  case "$answer" in
    y|Y|yes|YES) return 0 ;;
    *) return 1 ;;
  esac
}

page_output() {
  if [[ -t 1 ]] && command -v less >/dev/null 2>&1; then
    less -R
  else
    cat
  fi
}

tolower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

is_number() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

